DATABASE_URL="sqlite:./sqlite-db/calagopus_bot.db"
DATABASE_MIGRATE=true

GITHUB_CHANNEL_ID=123456789012345678
GITHUB_SPONSORS_LOGIN="calagopus"
# Currency the GitHub announcement messages show amounts in, defaults to the USD
# the sponsor was charged in.
# GITHUB_SPONSORS_MESSAGE_CURRENCY="EUR"
GITHUB_VERIFY_TOKEN="your_webhook_secret_here"
GITHUB_TOKEN=""
# GITHUB_OAUTH_CLIENT_ID="your_oauth_app_client_id"
# GITHUB_OAUTH_CLIENT_SECRET="your_oauth_app_client_secret"

# The collective contributions are read from; without it Open Collective stays off.
# The token is optional but requests are heavily rate limited without one.
# OPENCOLLECTIVE_SLUG="calagopus"
# OPENCOLLECTIVE_TOKEN="your_personal_token"
# OPENCOLLECTIVE_OAUTH_CLIENT_ID="your_oauth_app_client_id"
# OPENCOLLECTIVE_OAUTH_CLIENT_SECRET="your_oauth_app_client_secret"
# Currency the Open Collective announcement messages show amounts in, defaults to the
# currency the contributor was charged in.
# OPENCOLLECTIVE_MESSAGE_CURRENCY="USD"

# Where sponsorships from every platform are announced.
# SPONSORS_CHANNEL_ID=123456789012345678
# ISO 4217 code every amount is converted to for tiers, totals and the API, defaults to
# USD. It must be one Open Collective can quote an exchange rate for.
# SPONSORS_CURRENCY="USD"

# "<entry amount in cents>:<discord role id>" entries; the lowest amount qualifies
# every sponsor above zero. Only the highest earned role is held.
# DONATOR_TIERS="0:123456789012345678,5000:223456789012345678,25000:323456789012345678"
# SPONSOR_TIERS="0:423456789012345678,1000:523456789012345678"

# Granted on the first qualifying contribution and never taken away again; donator goes
# by lifetime total, sponsor by monthly amount.
# DONATOR_BASE_ROLE_ID=123456789012345678
# SPONSOR_BASE_ROLE_ID=223456789012345678

# Forum channel AI-assisted support is offered in; without it the whole feature stays off.
# Every new post there gets the unresolved tag and a message offering AI support, which the post
# author or a member holding one of AI_SUPPORT_ROLE_IDS can switch on. Those roles are also the
# only ones who can mark a post resolved, which swaps the tag and locks the post.
# AI_SUPPORT_CHANNEL_ID=123456789012345678
# AI_SUPPORT_ROLE_IDS=123456789012345678,223456789012345678
# AI_SUPPORT_UNRESOLVED_TAG_ID=123456789012345678
# AI_SUPPORT_RESOLVED_TAG_ID=223456789012345678
# OPENROUTER_API_KEY="sk-or-v1-..."
# Model that writes the answers, with the documentation MCP server as its tools.
# AI_SUPPORT_MODEL="z-ai/glm-5.3-flash"
# Cheap model that only decides whether a message needs an answer at all.
# AI_SUPPORT_TRIAGE_MODEL="z-ai/glm-5.3-flash"
# AI_SUPPORT_MCP_URL="https://calagopus.com/mcp"

# GUILD_ID=123456789012345678
BOT_TOKEN="xxx"

PORT=8090

APP_DEBUG=true
APP_URL="http://localhost:8090"
